# Salin menjadi .env.local lalu isi dari Supabase: Project Settings -> API
# (kunci "anon"/"publishable" memang publik; keamanan data dijaga oleh RLS di database, bukan oleh kerahasiaan kunci)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...atau sb_publishable_...
# Hanya untuk hosting di subpath (mis. GitHub Pages proyek): /nama-repo
NEXT_PUBLIC_BASE_PATH=
